    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scriptsLoaded = true; 
           // await logger.LogInformation("Scripts should be loaded by Oqtane framework (first render).");
            StateHasChanged(); 
        }

        if (_scriptsLoaded && !_isLoading && string.IsNullOrEmpty(_errorMessage) && _weatherData != null)
        {
            // Hourly Charts
            if (_weatherData.hourly != null && _weatherData.hourly.Any())
            {
              //  await logger.LogInformation("Attempting to render hourly charts.");
                try
                {
                    await RenderHourlyTempChart(_weatherData.hourly);
                    await RenderHourlyWindChart(_weatherData.hourly);
                 //   await logger.LogInformation("Hourly charts rendering initiated.");
                }
                catch (JSException ex) { await HandleChartJsError("Hourly", ex); }
                catch (Exception ex) { await HandleChartGeneralError("Hourly", ex); }
            }
            else { await logger.LogWarning("Hourly weather data is null or empty. Cannot render hourly charts."); }

            // Daily Charts
            if (_weatherData.daily != null && _weatherData.daily.Any())
            {
             //   await logger.LogInformation("Attempting to render daily charts.");
                try
                {
                    await RenderDailyTempChart(_weatherData.daily);
                    await RenderDailyWindChart(_weatherData.daily);
                  //  await logger.LogInformation("Daily charts rendering initiated.");
                }
                catch (JSException ex) { await HandleChartJsError("Daily", ex); }
                catch (Exception ex) { await HandleChartGeneralError("Daily", ex); }
            }
            else { await logger.LogWarning("Daily weather data is null or empty. Cannot render daily charts."); }

            // Initialize Map
            if (_locationData != null && double.TryParse(_latitude, System.Globalization.CultureInfo.InvariantCulture, out double lat) &&
                double.TryParse(_longitude, System.Globalization.CultureInfo.InvariantCulture, out double lon))
            {
                await InitializeMap(lat, lon);
            }
            else { await logger.LogWarning("Map cannot be initialized due to missing location data or invalid lat/lon settings."); }
        }
        else { LogSkippingChartOrMapRender(); }
    }

        private async Task HandleChartJsError(string chartType, JSException ex)
    {
        await logger.LogError(ex, "JavaScript error rendering {ChartType} chart(s): {ErrorMessage}", chartType, ex.Message);
        if (!_errorMessage?.Contains($"{chartType} Chart Error") == true)
        {
            _errorMessage = $"{chartType} Chart Error: {ex.Message}. Check browser console.";
            StateHasChanged();
        }
    }
    
    private async Task HandleChartGeneralError(string chartType, Exception ex)
    {
        await logger.LogError(ex, "General error rendering {ChartType} chart(s): {ErrorMessage}", chartType, ex.Message);
        if (!_errorMessage?.Contains($"{chartType} Chart Rendering Error") == true)
        {
            _errorMessage = $"{chartType} Chart Rendering Error: {ex.Message}.";
            StateHasChanged();
        }
    }

        private async void LogSkippingChartOrMapRender() // Changed to async void for logger calls
    {
        if (!_scriptsLoaded) await logger.LogWarning("Skipping render: Scripts not marked as loaded.");
       // if (_isLoading) await logger.LogWarning("Skipping render: Still loading data.");
        if (!string.IsNullOrEmpty(_errorMessage)) await logger.LogWarning("Skipping render: Error message present - {ErrorMessage}", _errorMessage);
      //  if (_weatherData == null) await logger.LogWarning("Skipping render: WeatherData is null.");
    }


    private async Task InitializeMap(double latitude, double longitude)
    {
        try
        {
            string mapDivId = $"weatherMap_{ModuleState.ModuleId}";
            string leafletImagesPath = ModulePath(); 
            // _mapZoom is now a class field, ensure it's set (e.g., in OnInitializedAsync from settings or a default)

           // await logger.LogInformation("Attempting to initialize map. ID: {MapID}, Lat: {Lat}, Lon: {Lon}, Zoom: {Zoom}, LocName: {LocName}, ImgPath: {ImgPath}",
            //    mapDivId, latitude, longitude, _mapZoom, _locationName, leafletImagesPath);

            // Ensure the JS function name matches what's in Module.js (e.g., "GIBS.OpenWeather.initializeMap")
            await JSRuntime.InvokeVoidAsync("GIBS.OpenWeather.initializeMap", 
                mapDivId, latitude, longitude, _mapZoom, _locationName, leafletImagesPath);
 
                //  await logger.LogInformation("Map initialization script invoked for {MapID}.", mapDivId);
        }
        catch (JSException ex)
        {
            await logger.LogError(ex, "JavaScript error initializing map: {ErrorMessage}", ex.Message);
            if (!_errorMessage?.Contains("Map Error") == true)
            {
                _errorMessage = $"Map Error: {ex.Message}. Check browser console.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "General error initializing map: {ErrorMessage}", ex.Message);
             if (!_errorMessage?.Contains("Map Initialization Error") == true)
            {
                _errorMessage = $"Map Initialization Error: {ex.Message}.";
                StateHasChanged();
            }
        }
    }
    
    
    private async Task RenderHourlyTempChart(Hourly[] hourlyArray)  
    {  
        if (hourlyArray == null || !hourlyArray.Any())
        {
            await logger.LogWarning("RenderHourlyTempChart called with no hourly data.");
            return;
        }

        var hourlyList = hourlyArray.ToList();  
        var labels = hourlyList.Take(24).Select(h => DateTimeOffset.FromUnixTimeSeconds(h.dt).ToLocalTime().DateTime.ToString("h tt")).ToList();  
        var temperatures = hourlyList.Take(24).Select(h => h.temp).ToList();  
        string canvasId = $"hourlyTempChart_{ModuleState.ModuleId}";  
        
       // await logger.LogInformation("Preparing to render chart with ID: {CanvasId}, Labels count: {LabelsCount}, Temps count: {TempsCount}", canvasId, labels.Count, temperatures.Count);

        var datasets = new List<ChartDataset>  
        {  
            new ChartDataset { Label = "Temperature (°F)", Data = temperatures, BorderColor = "rgba(75, 192, 192, 1)", BackgroundColor = "rgba(75, 192, 192, 0.2)", Fill = true }  
        };  
        await JSRuntime.InvokeVoidAsync("renderChart", canvasId, "line", labels, datasets, "Time", "Temperature (°F)");  
    } 

    private async Task RenderHourlyWindChart(Hourly[] hourlyArray)
    {
        if (hourlyArray == null || !hourlyArray.Any())
        {
            await logger.LogWarning("RenderHourlyWindChart called with no hourly data.");
            return;
        }

        var hourlyList = hourlyArray.ToList();
        var labels = hourlyList.Take(24).Select(h => DateTimeOffset.FromUnixTimeSeconds(h.dt).ToLocalTime().DateTime.ToString("h tt")).ToList();
        var windSpeeds = hourlyList.Take(24).Select(h => h.wind_speed).ToList();
        var windGusts = hourlyList.Take(24).Select(h => h.wind_gust).ToList(); // Assuming wind_gust is a double
        string canvasId = $"hourlyWindChart_{ModuleState.ModuleId}";

      //  await logger.LogInformation("Preparing to render Wind chart with ID: {CanvasId}, Labels count: {LabelsCount}, Wind Speeds count: {SpeedsCount}, Gusts count: {GustsCount}", canvasId, labels.Count, windSpeeds.Count, windGusts.Count);

        var datasets = new List<ChartDataset>
        {
            new ChartDataset { Label = "Wind Speed (mph)", Data = windSpeeds, BorderColor = "rgba(54, 162, 235, 1)", BackgroundColor = "rgba(54, 162, 235, 0.2)", Fill = true },
            new ChartDataset { Label = "Wind Gust (mph)", Data = windGusts, BorderColor = "rgba(255, 99, 132, 1)", BackgroundColor = "rgba(255, 99, 132, 0.2)", Fill = true } // Optional: dashed line for gusts  , BorderDash = new List<int> { 5, 5 }
