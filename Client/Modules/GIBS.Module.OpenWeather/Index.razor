    // Using Oqtane's IModuleControl.Resources to declare JS dependencies
    // This is the preferred way in Oqtane to ensure scripts are loaded correctly by the framework.
    public override List<Resource> Resources
    {
        get
        {
            // Ensure ModulePath() is available and correct. If not, paths might need adjustment.
            // For Chart.js from CDN, the path is absolute.
            // For Module.js, it's relative to the module's wwwroot folder.
            // Oqtane typically serves module assets from /Modules/[YourModuleFullName]/
            string leafletJsPath = ModulePath() + "leaflet.js"; 
            string moduleJsPath = ModulePath() + "Module.js"; 
            string leafletCSS = ModulePath() + "leaflet.css";
            string moduleCSS = ModulePath() + "Module.css"; 
            // Example: if ModulePath() is "/Modules/GIBS.Module.OpenWeather/", then moduleJsPath is "/Modules/GIBS.Module.OpenWeather/Module.js"

            return new List<Resource>
            {
                // Load Chart.js library first
                 new Resource { ResourceType = ResourceType.Stylesheet, Url = leafletCSS } ,
                  new Resource { ResourceType = ResourceType.Stylesheet, Url = moduleCSS },
                new Resource { ResourceType = ResourceType.Script, Url = "https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js" }, // Using a specific version of Chart.js v3
                new Resource { ResourceType = ResourceType.Script, Url = leafletJsPath },
                new Resource { ResourceType = ResourceType.Script, Url = moduleJsPath } 
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _OpenWeathers = await OpenWeatherService.GetOpenWeathersAsync(ModuleState.ModuleId);
            _apiKey = SettingService.GetSetting(ModuleState.Settings, "SettingApiKey", "");
            _latitude = SettingService.GetSetting(ModuleState.Settings, "SettingLatitude", "");
            _longitude = SettingService.GetSetting(ModuleState.Settings, "SettingLongitude", "");
            _mapZoom =  SettingService.GetSetting(ModuleState.Settings, "SettingZoomLevel", "");

            if (string.IsNullOrEmpty(_apiKey) && UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
            {
                AddModuleMessage("You Must Configure API Key In Module Settings", MessageType.Warning);
            }

            await LoadAndDisplayWeatherDataAsync(); 
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Initializing OpenWeather Component: {Error}", ex.Message);
            _errorMessage = $"Initialization Error: {ex.Message}"; // Show error in UI
            _isLoading = false; 
        }
    }

    // Removed AddScriptReference method as Oqtane's Resources property handles script loading.

    private async Task LoadAndDisplayWeatherDataAsync()
    {
        _isLoading = true;
        _errorMessage = null; 
        StateHasChanged(); 

        if (string.IsNullOrEmpty(_apiKey))
        {
            _errorMessage = "API Key is not configured. Please configure it in module settings.";
            if (!UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
            {
                _errorMessage = "Weather data cannot be loaded. API Key configuration is missing.";
            }
            _isLoading = false;
            StateHasChanged();
            return;
        }

        if (!double.TryParse(_latitude, System.Globalization.CultureInfo.InvariantCulture, out double lat) || 
            !double.TryParse(_longitude, System.Globalization.CultureInfo.InvariantCulture, out double lon))
        {
            _errorMessage = "Error: Invalid Latitude or Longitude in settings. Please correct them.";
            _isLoading = false;
            StateHasChanged();
            return;
        }

        WeatherProvider provider = new WeatherProvider(_apiKey, lat, lon);
        try
        {
            var weatherDataTask = provider.GetWeatherDataAsync();
            var overviewDataTask = provider.GetWeatherOverviewAsync();
            var locationDataTask = provider.GetLocationDataAsync();

            await Task.WhenAll(weatherDataTask, overviewDataTask, locationDataTask);

            _weatherData = await weatherDataTask;
            _weatherOverviewData = await overviewDataTask;
            _locationData = await locationDataTask;

            if (_weatherData == null && _weatherOverviewData == null && _locationData == null)
            {
                _errorMessage = "Failed to retrieve any weather information from the provider.";
            }
            else if (_locationData != null)
            {
                _locationName = $"{_locationData.name}, {_locationData.state}";
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading weather data from provider: {ErrorMessage}", ex.Message);
            _errorMessage = "An error occurred while fetching weather data. Check logs for details.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged(); 
        }
    }

