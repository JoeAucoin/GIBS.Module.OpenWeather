@using GIBS.Module.OpenWeather.Client.Services
@using GIBS.Module.OpenWeather.Services
@using GIBS.Module.OpenWeather.Models
@using GIBS.Module.OpenWeather
@namespace GIBS.Module.OpenWeather
@inherits ModuleBase
@inject IOpenWeatherService OpenWeatherService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer
@inject ISettingService SettingService

@* Removed: @inject IJSRuntime JSRuntime - Use JSRuntime from ModuleBase *@

@if (_OpenWeathers == null && _isLoading && string.IsNullOrEmpty(_errorMessage))
{
    <p><em>Loading Weather...</em></p>
}
else if (_isLoading && string.IsNullOrEmpty(_errorMessage))
{
    <p><em>Fetching weather data...</em></p>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
   <p style="color: red;">Error: @_errorMessage</p>
}
else
{
  

    <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add OpenWeather" ResourceKey="Add" />
    <br />

    @if (_OpenWeathers != null && _OpenWeathers.Count != 0)
    {
        <Pager Items="@_OpenWeathers">
            <Header>
                <th style="width: 1px;">&nbsp;</th>
                <th style="width: 1px;">&nbsp;</th>
                <th><b>@Localizer["Name"]</b></th>
            </Header>
            <Row>
                <td><ActionLink Action="Edit" Parameters="@($"id=" + context.OpenWeatherId.ToString())" ResourceKey="Edit"  /></td>
                <td><ActionDialog Header="Delete OpenWeather" Message="Are You Sure You Wish To Delete This OpenWeather?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" ResourceKey="Delete"  Id="@context.OpenWeatherId.ToString()" /></td>
                <td>@context.Name<br />@context.Description</td>
            </Row>
        </Pager>
    }
    @* else if (_OpenWeathers != null)
    {
      
    } *@


   

    @if (_isLoading)
    {
        <p><em>Loading weather data...</em></p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p style="color:red;">@_errorMessage</p>
    }
    else
    {
        @if (_weatherOverviewData != null && _locationData != null)
        {
             <h3>@_locationData.name, @_locationData.state</h3>
            <div id="weatherMap_@ModuleState.ModuleId" style="min-width: 300px; height: 360px; border: 1px solid #ccc; background-color: #f0f0f0;"></div>
        }
        

        <div id="weatherOverview">
            @if (_weatherOverviewData != null && _locationData != null)
            {
               
                <p>@_weatherOverviewData.weather_overview</p>
            }
            else if (_weatherData != null && _weatherOverviewData == null && _locationData == null)
            {
                <p>Failed to retrieve weather overview.</p>
            }
        </div>

        <!-- Weather Alerts -->
        @if (_weatherData?.alerts != null && _weatherData.alerts.Any())
        {
            <h3 id="weatherAlertsTitle">Weather Alerts</h3>
            <div id="weatherAlertsContainer">
                <ul>
                    @foreach (var alert in _weatherData.alerts)
                    {
                        var startTime = DateTimeOffset.FromUnixTimeSeconds(alert.start).ToLocalTime().DateTime;
                        var endTime = DateTimeOffset.FromUnixTimeSeconds(alert.end).ToLocalTime().DateTime;
                        <li class="alert-item">
                            <h4>@alert._event</h4>
                            <p><b>Sender:</b> @alert.sender_name</p>
                            <p><b>Period:</b> @startTime.ToString("M/d h:mm tt") - @endTime.ToString("M/d h:mm tt")</p>
                            <p>@alert.description</p>
                            @if (alert.tags != null && alert.tags.Any())
                            {
                                <p><b>Tags:</b> @string.Join(", ", alert.tags)</p>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        else if (_weatherData != null) 
        {
            <h3 id="weatherAlertsTitle" style="@((_weatherData.alerts == null || !_weatherData.alerts.Any()) ? "display:none;" : "")">Weather Alerts</h3>
            <div id="weatherAlertsContainer">
                <p style="text-align:center;font-size: 0.8em;">No weather alerts at this time.</p>
            </div>
        }

        <!-- Current Conditions -->
        <h3>Current Conditions</h3>
        <div id="currentWeather">
            @if (_weatherData?.current != null)
            {
                var current = _weatherData.current;
                <p>
                    @if (current.weather != null && current.weather.Any())
                    {

                        string myiconurl = "https://openweathermap.org/img/wn/" + current.weather[0].icon  + "@4x.png" ;
                        <img src="@myiconurl.ToString()" alt="@current.weather[0].description" title="@current.weather[0].description" style="float:right;" />
                        <span class="currentConditions">@current.weather[0].description.ToUpper()</span>

                        <br />
                    }
                    <b>Temperature:</b> @current.temp°F (Feels like: @current.feels_like°F)<br />
                    <b>Humidity:</b> @current.humidity%<br />
                    <b>Pressure:</b> @current.pressure hPa<br />
                    <b>Wind:</b> @current.wind_speed mph, @GetCompassDirection(current.wind_deg) (@current.wind_deg°)<br />
                    @if (current.wind_gust != 0)
                    {
                        string windgust = current.wind_gust + " mph";
                        <b>Wind Gust:</b> @windgust.ToString()
                    }
                   <br /><b>Clouds:</b> @current.clouds%<br />
                    @{
                        double visibilityInMiles = current.visibility * 0.000621371;
                    }
                    <b>Visibility:</b> @current.visibility.ToString("N0") meters (@visibilityInMiles.ToString("F2") miles)<br />
                    <b>UV Index:</b> @current.uvi<br />
                    <b>Sunrise:</b> @DateTimeOffset.FromUnixTimeSeconds(current.sunrise).ToLocalTime().DateTime.ToString("h:mm tt")<br />
                    <b>Sunset:</b> @DateTimeOffset.FromUnixTimeSeconds(current.sunset).ToLocalTime().DateTime.ToString("h:mm tt")
                </p>
            }
            else if (_weatherData != null)
            {
                <p>No current weather data available.</p>
            }
        </div>

        <hr class="thickhr">

        <!-- Hourly Forecast Charts -->
        <h3>Hourly Temperature and Wind Forecast</h3>
        <div id="hourlyForecastChartContainer" class="chart-container" style="height:300px;">
            @if (_weatherData?.hourly == null || !_weatherData.hourly.Any())
            { <p>Loading hourly forecast chart...</p> }
            else
            { <canvas id="hourlyTempChart_@ModuleState.ModuleId"></canvas> }
        </div>
        <div id="hourlyWindChartContainer" class="chart-container" style="height:300px;">
             @if (_weatherData?.hourly == null || !_weatherData.hourly.Any())
            { <p>Loading hourly wind chart...</p> }
            else
            { <canvas id="hourlyWindChart_@ModuleState.ModuleId"></canvas> }
        </div>


        <hr class="thickhr">

        <!-- Daily Forecast Charts -->
        <h3>Daily Temperature and Wind Forecast</h3>
        <div id="dailyTempChartContainer" class="chart-container" style="height:300px;">
            @if (_weatherData?.daily == null || !_weatherData.daily.Any())
            { <p>Loading daily forecast chart...</p> }
            else
            { <canvas id="dailyTempChart_@ModuleState.ModuleId"></canvas> }
        </div>
        <div id="dailyWindChartContainer" class="chart-container" style="height:300px;">
            @if (_weatherData?.daily == null || !_weatherData.daily.Any())
            { <p>Loading daily wind chart...</p> }
            else
            { <canvas id="dailyWindChart_@ModuleState.ModuleId"></canvas> }
        </div>

        <hr class="thickhr">

        <!-- Daily Forecast Details -->
        <h3>Daily Forecast</h3>
        <div id="dailyForecast">
            @if (_weatherData?.daily != null && _weatherData.daily.Any())
            {
                <ul>
                    @foreach (var day in _weatherData.daily)
                    {
                        var forecastDate = DateTimeOffset.FromUnixTimeSeconds(day.dt).ToLocalTime().DateTime;
                        var dayOfWeek = forecastDate.ToString("dddd");
                        var iconUrl = (day.weather != null && day.weather.Any()) ? $"https://openweathermap.org/img/wn/{day.weather[0].icon}@4x.png" : "";
                        var description = (day.weather != null && day.weather.Any()) ? day.weather[0].description : "N/A";

                        <li>
                            <span class="weatherDate">@dayOfWeek (@forecastDate.ToString("M/d"))</span>
                            @if (!string.IsNullOrEmpty(iconUrl))
                            {
                                <img src="@iconUrl" alt="@description" title="@description" style="float:right;" />
                            }
                            <br><b>Forecast:</b> @description?.ToUpper()
                            <br><b>High:</b> @day.temp?.max°F / <b>Low:</b> @day.temp?.min°F
                            <br><b>Day:</b> @day.temp?.day°F / <b>Night:</b> @day.temp?.night°F
                            <br><b>Morning:</b> @day.temp?.morn°F / <b>Evening:</b> @day.temp?.eve°F
                            <br><b>Feels Like:</b> Day @day.feels_like?.day°F / Night @day.feels_like?.night°F / Morn @day.feels_like?.morn°F / Eve @day.feels_like?.eve°F
                            <br><b>Precipitation Probability:</b> @((day.pop * 100).ToString("F0"))%
                            @if (day.rain.HasValue)
                            {
                                double rainInInches = day.rain.Value / 25.4;
                               string rainString =  day.rain.Value.ToString("F2") + " mm (" +  rainInInches.ToString("F2") + " in) " ;
                               <br><b>Rain: </b> @rainString.ToString()
                              
                            }
                            <br><b>Humidity:</b> @day.humidity%
                            <br><b>Wind:</b> @day.wind_speed mph, @GetCompassDirection(day.wind_deg) (@day.wind_deg°) (Gust: @day.wind_gust mph)
                            <br><b>Clouds:</b> @day.clouds%
                            <br><b>UV Index:</b> @day.uvi
                            <br><b>Sunrise:</b> @DateTimeOffset.FromUnixTimeSeconds(day.sunrise).ToLocalTime().DateTime.ToString("h:mm tt"), <b>Sunset:</b> @DateTimeOffset.FromUnixTimeSeconds(day.sunset).ToLocalTime().DateTime.ToString("h:mm tt")
                            <br><b>Moonrise:</b> @DateTimeOffset.FromUnixTimeSeconds(day.moonrise).ToLocalTime().DateTime.ToString("h:mm tt"), <b>Moonset:</b> @DateTimeOffset.FromUnixTimeSeconds(day.moonset).ToLocalTime().DateTime.ToString("h:mm tt"), <b>Moon Phase:</b> @day.moon_phase
                            <br><b>Summary:</b> @day.summary
                             <hr class="thickhr"> @* Moved inside li to be valid HTML *@
                        </li>
                    }
                </ul>
            }
            else if (_weatherData != null)
            {
                <p>No daily forecast data available.</p>
            }
        </div>
    }

    
<div class="owcredits"><cite>Weather data provided by <a href="https://openweathermap.org/" target="_blank">OpenWeather</a></cite></div>


}



