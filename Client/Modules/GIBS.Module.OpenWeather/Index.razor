        await JSRuntime.InvokeVoidAsync("renderChart", canvasId, "line", labels, datasets, "Time", "Wind Speed (mph)", true); // true for yAxisBeginAtZero
    }

    private async Task RenderDailyTempChart(Daily[] dailyArray)
    {
        if (dailyArray == null || !dailyArray.Any())
        {
            await logger.LogWarning("RenderDailyTempChart called with no daily data.");
            return;
        }

        var dailyList = dailyArray.ToList();
        var labels = dailyList.Select(d => DateTimeOffset.FromUnixTimeSeconds(d.dt).ToLocalTime().DateTime.ToString("M/d")).ToList();
        // Ensure Temp is not null before accessing Max/Min. Provide default (e.g., 0 or double.NaN) if it can be null.
        var maxTemps = dailyList.Select(d => d.temp?.max ?? 0).ToList(); 
        var minTemps = dailyList.Select(d => d.temp?.min ?? 0).ToList();
        string canvasId = $"dailyTempChart_{ModuleState.ModuleId}";

       // await logger.LogInformation("Preparing to render Daily Temp chart with ID: {CanvasId}, Labels count: {LabelsCount}, Max Temps: {MaxTempsCount}, Min Temps: {MinTempsCount}", canvasId, labels.Count, maxTemps.Count, minTemps.Count);
        
        var datasets = new List<ChartDataset>
        {
            new ChartDataset { Label = "Max Temp (°F)", Data = maxTemps, BorderColor = "rgba(255, 99, 132, 1)", BackgroundColor = "rgba(255, 99, 132, 0.2)", Fill = false },
            new ChartDataset { Label = "Min Temp (°F)", Data = minTemps, BorderColor = "rgba(54, 162, 235, 1)", BackgroundColor = "rgba(54, 162, 235, 0.2)", Fill = false }
        };
        await JSRuntime.InvokeVoidAsync("renderChart", canvasId, "line", labels, datasets, "Date", "Temperature (°F)");
    }

